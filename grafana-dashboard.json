{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping bbox7_exporter",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "bbox7_exporter on GitHub",
      "url": "https://github.com/almottier/bbox7_exporter",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "tooltip": "Source of the exported metrics",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": []
    }
  ],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["bbox", "bbox7", "bouygues", "router", "wifi7", "network"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Bbox 7 (Bouygues) — bbox7_exporter",
  "uid": "bbox7-exporter",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Bbox connection",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [ { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_up", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Box uptime",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "mappings": [], "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_device_uptime_seconds", "refId": "A" } ]
    },
    {
      "type": "gauge",
      "title": "Temperature",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 65 }, { "color": "red", "value": 80 } ] },
          "unit": "celsius",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_temperature_celsius", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Connected devices",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" }, "mappings": [], "unit": "none" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_hosts_total", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Internet state",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "2": { "text": "Up", "color": "green" } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "?", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 2 } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_wan_internet_state", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "VoIP line",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [ { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(bbox_voip_line_up)", "refId": "A" } ]
    },
    {
      "type": "table",
      "title": "Box information",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 5 },
      "id": 8,
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "filterable": false }, "mappings": [], "unit": "none" }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_device_info", "format": "table", "instant": true, "refId": "A" } ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "serial": true }, "renameByName": { "model_name": "Model", "firmware": "Firmware" } } }
      ]
    },

    {
      "type": "row",
      "title": "WAN Connectivity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 60,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Fiber link (FTTH)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 10 },
      "id": 61,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [ { "type": "value", "options": { "0": { "text": "Inactive", "color": "red" }, "1": { "text": "Active", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_device_fai_active{using=\"ftth\"}", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Internet outages (24h)",
      "description": "Number of up→down transitions over the last 24h, derived from bbox_wan_ip_up. Limited to the history stored in Prometheus.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 5, "x": 4, "y": 10 },
      "id": 62,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "changes(bbox_wan_ip_up[24h]) / 2", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Internet availability (24h)",
      "description": "Percentage of time the WAN IPv4 link was up over 24h.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 5, "x": 9, "y": 10 },
      "id": 63,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 } ] },
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg_over_time(bbox_wan_ip_up[24h]) * 100", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Offline time (24h)",
      "description": "Cumulative time the WAN link was down over 24h (sampled at the scrape interval).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 5, "x": 14, "y": 10 },
      "id": 64,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 300 } ] },
          "unit": "s"
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum_over_time((bbox_wan_ip_up == bool 0)[24h:1m]) * 60", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Current session",
      "description": "Time since the last observed WAN outage (7d window). \"No data\" means no outage was seen in the window.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 5, "x": 19, "y": 10 },
      "id": 65,
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "mappings": [], "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "time() - max_over_time(timestamp(bbox_wan_ip_up == 0)[7d:1m])", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "WAN link state (IPv4 / IPv6 / Internet)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "id": 66,
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "gradientMode": "none", "lineWidth": 2, "lineInterpolation": "stepAfter", "showPoints": "never", "axisCenteredZero": false },
          "mappings": [],
          "unit": "none",
          "min": 0,
          "max": 1.2
        },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["min"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_wan_ip_up", "legendFormat": "IPv4 up", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_wan_ip6_up", "legendFormat": "IPv6 up", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "clamp_max(bbox_wan_internet_state, 1)", "legendFormat": "Internet up", "refId": "C" }
      ]
    },

    {
      "type": "row",
      "title": "WAN",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 10,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "WAN throughput (instant)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 11,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "gradientMode": "opacity", "lineWidth": 2, "showPoints": "never", "axisCenteredZero": false }, "mappings": [], "unit": "bps" }, "overrides": [ { "matcher": { "id": "byName", "options": "tx" }, "properties": [ { "id": "custom.transform", "value": "negative-Y" } ] } ] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_wan_bandwidth_kbits * 1000", "legendFormat": "{{direction}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "WAN traffic (from counters)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 12,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "gradientMode": "opacity", "lineWidth": 2, "showPoints": "never", "axisCenteredZero": false }, "mappings": [], "unit": "bps" }, "overrides": [ { "matcher": { "id": "byName", "options": "tx" }, "properties": [ { "id": "custom.transform", "value": "negative-Y" } ] } ] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(bbox_wan_bytes_total[$__rate_interval]) * 8", "legendFormat": "{{direction}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "WAN link occupation",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 13,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "axisCenteredZero": false }, "mappings": [], "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_wan_occupation_percent", "legendFormat": "{{direction}}", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "WAN errors / discards",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 14,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "axisCenteredZero": false }, "mappings": [], "unit": "pps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(bbox_wan_packets_errors_total[$__rate_interval])", "legendFormat": "errors", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(bbox_wan_packets_discards_total[$__rate_interval])", "legendFormat": "discards", "refId": "B" }
      ]
    },

    {
      "type": "row",
      "title": "Wi-Fi",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 20,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Wi-Fi traffic per band",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 21,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 15, "gradientMode": "opacity", "lineWidth": 2, "showPoints": "never", "axisCenteredZero": false }, "mappings": [], "unit": "bps" }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*tx.*" }, "properties": [ { "id": "custom.transform", "value": "negative-Y" } ] } ] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(bbox_wifi_bytes_total[$__rate_interval]) * 8", "legendFormat": "{{band}} GHz {{direction}}", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Channel per band",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 40 },
      "id": 22,
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "mappings": [], "unit": "none" }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_wifi_channel", "legendFormat": "{{band}} GHz", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Channel width (MHz)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 40 },
      "id": 23,
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "mappings": [], "unit": "none" }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "bbox_wifi_bandwidth_mhz", "legendFormat": "{{band}} GHz", "refId": "A" } ]
    },

    {
      "type": "row",
      "title": "LAN",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "id": 30,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Throughput per LAN port",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 49 },
      "id": 31,
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "axisCenteredZero": false }, "mappings": [], "unit": "bps" }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*tx.*" }, "properties": [ { "id": "custom.transform", "value": "negative-Y" } ] } ] },
